# Cloudflare Pages / Netlify header rules.
#
# The vendored sim's assets only ever change by re-vendoring, so they can
# cache hard; HTML must always revalidate or a launch-day fix never reaches
# anyone who already visited.

/DEVICE_KNIGHT/assets/*
  Cache-Control: public, max-age=31536000, immutable

# THE INDEXES MUST REVALIDATE. These two files are the vendored assets'
# tables of contents and they CHANGE on re-vendor — immutable caching is
# how the mus_knight fix could never reach a returning visitor (their
# browser held the old audio index for a year). Binaries stay immutable;
# the manifests do not.
# (the ! line detaches the wildcard rule's header first — without it the
# platform APPENDS, and the file serves "immutable" and "max-age=0" in one
# merged header, leaving the browser to pick)
/DEVICE_KNIGHT/assets/audio/index.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/DEVICE_KNIGHT/assets/sprites/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/og/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
